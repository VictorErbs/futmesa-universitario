generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Tournament {
  id            String            @id @default(uuid())
  title         String
  description   String?
  format        String            @default("SINGLE_ELIMINATION") // 'SINGLE_ELIMINATION', 'GROUPS_AND_KNOCKOUT'
  modality      String            @default("DOUBLES")            // 'INDIVIDUAL', 'DOUBLES'
  status        String            @default("REGISTRATION")       // 'REGISTRATION', 'IN_PROGRESS', 'FINISHED'
  setsToWin     Int               @default(2)                    // Ex: 2 para melhor de 3, ou 1 para melhor de 1
  pointsPerSet  Int               @default(18)                   // 18 pontos padrão do MesaMatch
  advantageRule Boolean           @default(true)                 // Diferença de 2 pontos
  location      String?
  community     String?           // Bairro ou comunidade de Olinda (ex: Rio Doce, Peixinhos, Alto da Sé)
  sponsors      String?           // Apoiadores e comércios locais
  rulesNote     String?           // Observações de regras locais
  startDate     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  participants  Participant[]
  groups        TournamentGroup[]
  matches       Match[]
}

model Participant {
  id                 String          @id @default(uuid())
  tournamentId       String
  tournament         Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name               String
  nickname           String?         // Vulgo / Apelido no bairro (ex: Dadá, Juninho)
  partnerName        String?         // para duplas 2x2
  partnerNickname    String?         // Apelido do parceiro
  neighborhood       String?         // Bairro de Olinda (ex: Rio Doce, Peixinhos, Bultrins)
  communityOrProject String?         // Equipe, Arena ou Projeto Social
  phone              String?
  email              String?
  seed               Int?
  status             String          @default("PENDING") // 'CONFIRMED', 'PENDING', 'ELIMINATED'
  phoneVerified      Boolean         @default(false)
  verificationCode   String?
  codeExpiresAt      DateTime?
  groupName          String?
  createdAt          DateTime        @default(now())
  matchesAsP1        Match[]         @relation("Participant1")
  matchesAsP2        Match[]         @relation("Participant2")
  matchesWon         Match[]         @relation("Winner")

  @@index([tournamentId])
  @@index([status])
  @@index([neighborhood])
  @@index([phoneVerified])
}

model TournamentGroup {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String     // 'Grupo A', 'Grupo B'
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
}

model Match {
  id             String       @id @default(uuid())
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage          String       // 'GROUPS', 'ROUND_OF_16', 'QUARTER_FINALS', 'SEMI_FINALS', 'FINAL', 'THIRD_PLACE'
  round          Int          @default(1)
  matchNumber    Int          @default(1)
  groupName      String?
  participant1Id String?
  participant1   Participant? @relation("Participant1", fields: [participant1Id], references: [id], onDelete: SetNull)
  participant2Id String?
  participant2   Participant? @relation("Participant2", fields: [participant2Id], references: [id], onDelete: SetNull)
  winnerId       String?
  winner         Participant? @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)
  status         String       @default("SCHEDULED") // 'SCHEDULED', 'IN_PROGRESS', 'FINISHED'
  nextMatchId    String?
  nextMatchSlot  Int?         // 1 para slot P1 do próximo jogo, 2 para slot P2
  court          String?
  sets           MatchSet[]
  createdAt      DateTime     @default(now())

  @@index([tournamentId])
  @@index([stage])
  @@index([status])
  @@index([participant1Id])
  @@index([participant2Id])
}

model MatchSet {
  id         String   @id @default(uuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber  Int
  score1     Int      @default(0)
  score2     Int      @default(0)
  isFinished Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([matchId])
}

